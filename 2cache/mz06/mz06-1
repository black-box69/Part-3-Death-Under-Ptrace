#include <sys/types.h>
#include <dirent.h>
#include <stdio.h>
#include <stdlib.h>
#include <sys/file.h>
#include <sys/stat.h>
#include <limits.h>
#include <string.h>
#include <unistd.h>

//made by: 2cache

int
main(int argc, char *argv[])
{
    DIR *d = opendir(argv[1]);
    if (!d) {
        exit(1);
    }
    struct dirent *dd;
    long long ammo = 0;
    while ((dd = readdir(d))) {
        if (!strcmp(dd->d_name, ".") || !strcmp(dd->d_name, "..")) {
            continue;
        }
        char path[PATH_MAX];
        snprintf(path, sizeof(path), "%s/%s", argv[1], dd->d_name);
        struct stat stb;
        if (stat(path, &stb) < 0) {
            continue;
        }
        if (S_ISREG(stb.st_mode) && !access(path, X_OK) && !(strcmp(".exe", path + strlen(path) - 4))) {
            ammo++;
            // printf(">>%s\n", path);
        }
    }
    printf("%lld\n", ammo);
    closedir(d);
}
