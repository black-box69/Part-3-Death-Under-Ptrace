int
main(int argc, char *argv[])
{
    if (argc != 6) {
        exit(1);
    }

    int fds[2];
    pipe(fds);

    int fd1 = open(argv[4], O_RDONLY);
    int fd2 = open(argv[5], O_WRONLY | O_APPEND | O_CREAT, 0600);
    int pid = fork();
    if (!pid) {
        close(fds[0]);
        pid = fork();
        if (!pid) {
            dup2(fd1, 0);
            dup2(fds[1], 1);
            close(fd1);
            close(fds[1]);
            execlp(argv[1], argv[1], NULL);
            _exit(1);
        }
        close(fd1);
        int status;
        wait(&status);
        if (WIFEXITED(status) && WEXITSTATUS(status) == 0) {
            pid = fork();
            if (!pid) {
                dup2(fds[1], 1);
                close(fds[1]);
                execlp(argv[2], argv[2], NULL);
                _exit(1);
            }
        }
        close(fds[1]);
        wait(NULL);
        exit(0);
    }
    close(fds[1]);
    close(fd1);
    pid = fork();
    if (!pid) {
        dup2(fds[0], 0);
        dup2(fd2, 1);
        close(fds[0]);
        close(fd2);
        execlp(argv[3], argv[3], NULL);
        _exit(1);
    }
    close(fds[0]);
    close(fd2);
    wait(NULL);
    wait(NULL);
    _exit(0);
}
