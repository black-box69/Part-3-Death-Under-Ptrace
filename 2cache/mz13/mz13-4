void
kill_mass(int *pids, int len)
{
    for (int i = 0; i < len; i++) {
        kill(pids[i], SIGTERM);
    }
    for (int i = 0; i < len; i++) {
        wait(NULL);
    }
    exit(1);
}

void
close_pipes(const char *fmt, ...)
{
    va_list args;
    va_start(args, fmt);

    while (*fmt != '\0') {
        if (*fmt == 'f') {
            int fd = va_arg(args, int);
            if (close(fd) == -1) {
                fprintf(stderr, "wrong\n");
            }
        }
        ++fmt;
    }
}

void
safe_execlp(int pid, char *cmd)
{
    if ((pid = fork()) == 0) {
        execlp(cmd, cmd, NULL);
        _exit(1);
    } else if (pid == -1) {
        exit(1);
    } else {
        int res;
        waitpid(pid, &res, 0);
        // return 0;
    }
}

