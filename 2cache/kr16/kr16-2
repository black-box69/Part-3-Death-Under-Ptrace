int main(int argc, char *argv[]) {
	int pid = 0;
	int fd[2];
	pipe(fd);
	dup2(fd[0], 0);
	if ((pid = fork()) == 0) {
		close(fd[0]);
		dup2(fd[1], 1);
		close(fd[1]);
		execlp("gpg", "gpg", "-d", "--batch", "--passphrase", argv[2], "--pinentry-mode", "loopback", "--quiet", "--no-tty", "--no-keyring", argv[1], NULL);
		//execlp("ls", "ls", "-l", NULL);
		//execlp("gpg", "gpg", "-d", "--batch", "--passphrase", argv[2], argv[1], NULL);
		_exit(1);
	} else {
		close(fd[1]);
		wait(NULL);
	}
	long long sum = 0;
	long long buf = 0;
	FILE *fr = fdopen(fd[0], "r");
	while (fscanf(fr, "%lld", &buf) == 1) {
		sum += buf;
	}
	//fprintf()
	close(fd[0]);
	printf("%lld\n", sum);
	//printf("deciphered\n");
}
