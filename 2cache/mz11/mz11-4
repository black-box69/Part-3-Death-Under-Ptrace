#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>
#include <sys/wait.h>
#include <unistd.h>

//made by: 2cache

int
main(void)
{
    int n = 0;
    setbuf(stdin, 0);
    setbuf(stdout, 0);
    fscanf(stdin, "%d", &n);
    if (n > 1) {
        printf("1 ");
    } else if (n > 0) {
        printf("1\n");
        exit(0);
    } else {
        exit(0);
    }

    int pid = 0;
    for (int i = 1; i < n; i++) {
        wait(NULL);
        if ((pid = fork()) == 0) {
            fflush(stdout);
            if (i == n - 1) {
                printf("%d\n", i + 1);
            } else {
                printf("%d ", i + 1);
            }
            exit(0);
            continue;
        }
    }
    fflush(stdout);
    for (int i = 1; i < n; i++) {
        wait(NULL);
    }
    exit(0);
}

