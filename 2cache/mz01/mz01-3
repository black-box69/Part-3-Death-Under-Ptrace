#include <stdio.h>
#include <stdlib.h>

//made by: 2cache

enum
{
    TOP_EDGE_OF_N = 2000,
    BOT_EDGE_OF_N = 1
};

int
is_prime(int n)
{
    for (int i = 2; i * i <= n; i++) {
        if (!(n % i)) {
            return 0;
        }
    }
    return 1;
}

int
main(void)
{
    int n, res;
    if (scanf("%d", &n) != 1) {
        exit(1);
        fprintf(stderr, "Err");
    }

    if (n >= TOP_EDGE_OF_N || n <= BOT_EDGE_OF_N || !is_prime(n)) {
        fprintf(stderr, "incorrect value\n");
        exit(1);
    }

    int *arr = malloc(sizeof(*arr) * (n - 1));

    if (!arr) {
        exit(1);
        fprintf(stderr, "Err");
    }

    for (res = 0; res < n; res++) {
        for (int i = 1; i < n; i++) {
            if ((res * i) % n == 1) {
                arr[i - 1] = res;
            }
        }
    }

    for (int i = 0; i < n - 1; i++) {
        printf("0 ");
    }
    printf("\n");

    for (int k = 1; k < n; k++) {
        for (int i = 0; i < n - 1; i++) {
            printf("%d ", (arr[i] * k) % n);
        }
        printf("\n");
    }
    free(arr);
}

