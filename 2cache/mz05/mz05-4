#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>

//made by: 2cache

int
comp(const void *arg1, const void *arg2)
{
    const char *s1 = *(char **) arg1;
    const char *s2 = *(char **) arg2;

    struct stat st1 = {0};
    struct stat st2 = {0};

    if (stat(s1, &st1) == -1) {
        exit(1);
    }
    if (stat(s2, &st2) == -1) {
        exit(1);
    }

    int res = 0;
    if (st1.st_ino > st2.st_ino) {
        res = 1;
    } else if (st1.st_ino < st2.st_ino) {
        res = -1;
    } else {
        res = -strcmp(s1, s2);
    }
    return res;
}

int
comp_str(const void *arg1, const void *arg2)
{
    return strcmp(*(char **) arg1, *(char **) arg2);
}

int
main(int argc, char *argv[])
{
    struct stat stbuf = {0};
    int n = 0;
    for (int i = 1; i < argc; i++) {
        if (stat(argv[i], &stbuf) != -1) {
            argv[n] = argv[i];
            n++;
        }
    }

    if (n > 0) {
        qsort(argv, n, sizeof(argv[0]), comp);
        int j = 1;
        char *buf = argv[0];
        if (n > 1) {
            struct stat stb1 = {0};
            struct stat stb2 = {0};
            for (int i = 1; i < n; i++) {
                if (stat(buf, &stb1) == -1) {
                    exit(1);
                }
                if (stat(argv[i], &stb2) == -1) {
                    exit(1);
                }
                if (stb1.st_ino != stb2.st_ino) {
                    argv[j] = argv[i];
                    j++;
                }
                buf = argv[i];
            }
            qsort(argv, j, sizeof(argv[0]), comp_str);
        }
        for (int i = 0; i < j; i++) {
            printf("%s\n", argv[i]);
        }
    }
}
