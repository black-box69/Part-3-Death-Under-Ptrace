#include <stdio.h>
#include <signal.h>
#include <unistd.h>
#include <stdlib.h>

//made by: 2cache

volatile sig_atomic_t n = 0;
volatile sig_atomic_t num = 0;

int
is_prime(int x)
{
    for (int i = 2; i * i <= x; i++) {
        if (!(x % i)) {
            return 0;
        }
    }
    return 1;
}

void
handler(int s)
{
    if (s == SIGINT) {
        if (n >= 3) {
            exit(0);
        }
        printf("%d\n", num);
        fflush(stdout);
        n++;
    } else if (s == SIGTERM) {
        exit(0);
    }
}

struct sigaction s = {.sa_handler = handler, .sa_flags = SA_RESTART};

int
main(void)
{
    sigaction(SIGINT, &s, NULL);
    sigaction(SIGTERM, &s, NULL);

    int low;
    int high;
    scanf("%d%d", &low, &high);

    printf("%d\n", getpid());
    fflush(stdout);

    for (int i = ((low < 2) ? 2 : low); i < high; i++) {
        // sleep(1);//!!!!
        if (is_prime(i)) {
            num = i;
        }
    }
    printf("-1\n");
    fflush(stdout);
    exit(0);
}
